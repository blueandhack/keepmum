# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/

# Generated by bench/gen.py: synthetic, but provider-shaped keys trip GitHub push protection.
bench/data/secrets.jsonl
bench/data/pii.jsonl
bench/data/long.jsonl
bench/data/extra.jsonl
# Rebuilt by bench/guard_public.py from pinned public sources; SWE-chat's are real users' sessions.
bench/data/guard-public/

# Rendered by docs/video/flow.swift; regenerate rather than commit a 7 MB binary.
docs/video/*.mp4

# Mac app build output
mac/.build/
mac/build/
*.xcodeproj/xcuserdata/
.swiftpm/

# macOS and editors
.DS_Store
.vscode/
.idea/
mac/.sparkle/
sparkle-private-key*

# Cloudflare's CLI (wrangler) account cache, and its local state for worker/
.cloudflare/
.wrangler/

# wrangler dev only: opens /stats without Cloudflare Access (worker/README.md)
.dev.vars

# e2e runs: transcripts and requests can hold what an agent sent (e2e/README.md)
e2e/results/
# Your own copy of e2e/keys.env.example: 1Password references to the live-run API keys.
e2e/keys.env

# coverage run (CI fails below fail_under in pyproject.toml)
.coverage
.coverage.*
htmlcov/
bench/data/gguf/
bench/data/ft/
