---
// The header's links: keepmum.app's own home first, so every docs page leads back to the site
// (the logo goes to the docs' own front page), then Starlight's GitHub icon.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
---

<a href="/" class="home">keepmum.app</a>
<Default />

<style>
	.home {
		color: var(--sl-color-text-accent);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}
	.home:hover {
		color: var(--sl-color-white);
	}
</style>
